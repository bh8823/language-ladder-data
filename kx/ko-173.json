{"Xdp7trIzrmg":[["정리","정리하래요. 설거지하고.",373,388,5.06,15],["다음","그다음에 커피 머신을 청소해요.",646,653,5.69,12],["공포","공포 게임이야. 공포 게임. 카페 시뮬레이션 공포 게임.",2061,2072,4.58,11],["귀신","할아버지 손님은 귀신을 말하는 거 같은데.",1278,1285,4.31,10],["노랑","범인은 노랑이다. 범인은 파랑이다.",4389,4396,3.91,9],["라떼","우유 카페라떼 우유 아 스팀 밀크 어",308,318,3.63,8],["전등","네, 사장님, 어제부터 카페 전등이 이상해서 전화했어요.",3063,3073,3.37,3],["광고판","표지판을 세우고요. 광고판페모카를 만들어요.",1022,1030,3.11,3]],"ITvZNb6rI_s":[["회사","회사에서 혼났어요? 아 그냥 어디 좀 부딪쳤는데 지금은",120,130,5.31,6],["아이",">> 아이 참 아빠는 이럴 땐 그래도",62,69,5.72,5],["캠프","그러면 지옥 캠프에 오신 것을 환영합니다. 여기서 담배를 끊지",1838,1846,4.55,3],["당장",">> 모두 내 말 잘 들어. 오늘부터 당장",1609,1615,4.73,2],["양반",">> 이양반이 >> 아빠 껌을 대체 몇 개나 씹은 거야?",284,293,4.05,2],["미미",">> 미미야 넌 역시 날 실망시키지",829,834,4.01,2],["영식",">> 아이 저기 혹시 영식이 안사람 되시는",1954,1962,3.18,2],["생활관",">> 저희 한국 예절 생활관으로 오세요.",960,966,3.13,2]],"u6y2Ka95u6c":[["안녕","딜리가 왔습니다. 와 안녕하십니까? 우와",52,61,5.37,4],["시험",">> 시험 잘 보셨어요? >> 네.",148,152,5.02,4],["우와","우와 >> 오감 처에 알려드릴네.",56,61,4.22,3],["한국인","한국에서 진실로 한국인 상에서 살아서 한국어를 배우는 거는 훨씬 빨리",791,800,4.63,2],["컨텐츠","수고했어. 오늘도 컨텐츠예요. >> 어",450,456,4.17,1],["비주얼",">> 감사합니다. 비주얼 >> 배고프지? 아무도 안 먹었다고.",836,847,4.11,1],["치과",">> 좋아. 어 근데 치과 주문 그 뭐지?",719,725,4.09,1],["스텝",">> 스텝인 줄 알고. >> 놀랬겠다.",402,410,4.06,1],["아리",">> 아리가 >> 와 진짜",1131,1138,4.02,1],["주스",">> 아 감사합니다. 오렌지 주스 >> 오이갓",831,837,4.02,1],["식단","미키스컨식단에서 그 알바하고 있었.",685,690,3.59,1],["대공","대공 >> 성공.",412,418,3.57,1],["불안감","불안감죠. ",254,261,3.52,1],["스크롤","않아요? 스마트폰 스크롤을 내리다 보면 세상엔 다 완벽한 사람들 뿐인",237,246,3.52,1],["중학",">> 중학생이었어 가지고. 중학교 2학년. >> 음.",913,921,3.5,1]]}